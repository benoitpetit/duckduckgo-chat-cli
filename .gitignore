# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env
duckduckchat

# build output
build/

# Executable binaries
duckduckgo-chat-cli
duckduckgo-chat-cli_*
duckchat*
!browser-extension/duckchat-relay/
!browser-extension/duckchat-relay/**

# Local design and implementation notes stay outside the public source tree.
docs/superpowers/
# Local analysis material and generated Wails cache stay out of Git.
/reverse/
/.wails-cache/
# MIRA project data
.mira/
