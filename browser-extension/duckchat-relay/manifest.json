{
  "manifest_version": 3,
  "name": "DuckChat CLI browser retry",
  "version": "1.0.1",
  "key": "",
  "description": "Retries a Duck.ai CLI request through the active Duck.ai page session.",
  "permissions": ["scripting", "browsingData"],
  "host_permissions": [
    "https://duck.ai/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://duck.ai/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
